# Monzero release build environment: Ubuntu 22.04 (glibc 2.35 = strict floor)
# with the toolchains needed by contrib/depends for Linux and Windows targets.
FROM docker.io/library/ubuntu@sha256:281c5745f657873d78e5531fc5ba8575f46ab7769b94550ac99543f122679986
ENV DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8
RUN apt-get update && apt-get install --no-install-recommends -y \
      autoconf automake autotools-dev bison bsdmainutils build-essential bzip2 \
      ca-certificates cmake curl file git gperf libtool make patch pkg-config \
      python3 xz-utils g++-mingw-w64-x86-64 binutils-mingw-w64-x86-64 \
 && update-alternatives --set x86_64-w64-mingw32-gcc /usr/bin/x86_64-w64-mingw32-gcc-posix \
 && update-alternatives --set x86_64-w64-mingw32-g++ /usr/bin/x86_64-w64-mingw32-g++-posix \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
